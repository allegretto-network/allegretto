{
  "name": "@allegretto-network/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "test": "vp test",
    "compose": "mesh-compose -o src/lib/mesh/supergraph.graphql",
    "codegen:mesh": "graphql-codegen --config scripts/mesh.ts",
    "codegen": "vpr compose && vpr codegen:mesh",
    "typegen": "wrangler types --env-interface CloudflareBindings",
    "deploy": "vpr build && wrangler deploy",
    "preview": "vp preview"
  },
  "dependencies": {
    "@allegretto-network/core": "workspace:*",
    "@allegretto-network/utils": "workspace:*",
    "@graphql-hive/gateway-runtime": "catalog:",
    "@graphql-mesh/transport-http": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "dataloader": "catalog:",
    "graphql": "catalog:",
    "graphql-tag": "catalog:",
    "hono": "catalog:",
    "hono-problem-details": "catalog:",
    "jose": "catalog:",
    "uuid": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-generic-sdk": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-mesh/compose-cli": "catalog:",
    "@graphql-mesh/types": "catalog:",
    "@types/node": "catalog:",
    "jsonc-parser": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
